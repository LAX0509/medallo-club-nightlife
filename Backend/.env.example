# Copiar este archivo como .env y ajustar los valores para el entorno local.

ENVIRONMENT=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nightlife_db

# Seguridad / JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (lista separada por comas, se interpreta como JSON list o CSV)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Reglas de negocio del motor de riesgos y comisiones
VALOR_BASE_POR_INVITADO_COP=20000
UMBRAL_SOBREAFORO_MEDIO=0.85
UMBRAL_SOBREAFORO_ALTO=1.0
UMBRAL_ZSCORE_COMISION_ATIPICA=2.0

# Avisos de nuevas reservas por WhatsApp Cloud API (Meta). Dejar vacío para desactivarlo.
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Número destino en formato internacional solo dígitos, por ejemplo 573001234567.
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=medallo_nueva_reserva
WHATSAPP_TEMPLATE_LANGUAGE=es
# Plantilla aprobada para cliente; variables de cuerpo: nombre, evento, tipo, personas, código reserva.
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=medallo_reserva_confirmada_v2
WHATSAPP_CONFIRMATION_TEMPLATE_LANGUAGE=es
# URL pública de la página para solicitar reservas desde el bot.
WHATSAPP_RESERVATION_PAGE_URL=http://localhost:5173/reservas
# Prefijo opcional del botón de administración de reservas.
WHATSAPP_RESERVATION_URL_PREFIX=
# Plantilla de servicio aprobada para alertas de inventario; requiere aprobación de Meta.
WHATSAPP_INVENTORY_NOTIFY_TO=
WHATSAPP_INVENTORY_TEMPLATE_NAME=medallo_alerta_inventario
WHATSAPP_INVENTORY_TEMPLATE_LANGUAGE=es
# Webhook de WhatsApp Cloud API. Usa un token propio y el App Secret de Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# URL publica del frontend: se usa en enlaces de reservas, pases y codigos QR.
PUBLIC_FRONTEND_URL=http://localhost:5173

# Asistente de IA (Google Gemini). Opcional: sin GEMINI_API_KEY el asistente funciona con su motor local.
# Clave GRATUITA (sin tarjeta) en https://aistudio.google.com/apikey ; NUNCA debe subirse a git.
GEMINI_API_KEY=
# Claves extra (separadas por coma) de OTROS proyectos/cuentas de Google, p. ej. una por integrante del equipo.
# La cuota es por proyecto: dos claves del MISMO proyecto no suman. Si una se agota, responde la siguiente.
GEMINI_API_KEYS_EXTRA=
# Modelo principal: gemini-3.6-flash (1-2 s; funciona con proyectos nuevos, donde 2.5 ya no esta disponible).
GEMINI_MODEL=gemini-3.6-flash
# Respaldo (separados por coma): se usa si el principal se agota o se satura. Cada modelo tiene su
# PROPIA cuota gratuita diaria, asi que la cadena suma capacidad. Lo que no alcance lo atiende el motor local.
GEMINI_MODEL_RESPALDO=gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Tope TOTAL por consulta (incluye respaldos); al pasarse, el bot responde con su motor local.
GEMINI_TIMEOUT_SECONDS=20

# Respaldo gratuito: Groq (API compatible con OpenAI). Responde si toda la cadena de Gemini falla o se agota.
# Clave gratis (sin tarjeta) en https://console.groq.com/keys ; NUNCA debe subirse a git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_RESPALDO=qwen/qwen3.8-27b,openai/gpt-oss-20b
